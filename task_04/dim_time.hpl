      <yloc>304</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Year and decade</name>
    <type>Calculator</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <calculation>
      <calc_type>ADD</calc_type>
      <field_a>start_year</field_a>
      <field_b>offset</field_b>
      <field_name>year</field_name>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>Integer</value_type>
    </calculation>
    <calculation>
      <calc_type>REMAINDER</calc_type>
      <field_a>year</field_a>
      <field_b>ten</field_b>
      <field_name>remainder</field_name>
      <remove>Y</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>Integer</value_type>
    </calculation>
    <calculation>
      <calc_type>SUBTRACT</calc_type>
      <field_a>year</field_a>
      <field_b>remainder</field_b>
      <field_name>decade</field_name>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>Integer</value_type>
    </calculation>
    <failIfNoFile>Y</failIfNoFile>
    <attributes/>
    <GUI>
      <xloc>560</xloc>
      <yloc>304</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Year range</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>aid_staging</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT MIN(first_year) AS start_year,
  MAX(last_year) AS end_year,
  MAX(last_year) - MIN(first_year) AS nr_clones,
  10 AS ten
FROM (
  SELECT MIN(year) AS first_year, MAX(year) AS last_year FROM stg_maddison
  UNION ALL
  SELECT MIN(year), MAX(year) FROM stg_wdi
  UNION ALL
  SELECT MIN(year), MAX(year) FROM stg_events
) AS t</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>304</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
