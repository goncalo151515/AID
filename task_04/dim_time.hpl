  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Year range</from>
      <to>One row per year</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>One row per year</from>
      <to>Year and decade</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Year and decade</from>
      <to>Load DIM_TIME</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Load DIM_TIME</name>
    <type>InsertUpdate</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>100</commit>
    <connection>aid_dw</connection>
    <lookup>
      <key>
        <condition>=</condition>
        <field>year</field>
        <name>year</name>
      </key>
      <schema>aid_dw</schema>
      <table>DIM_TIME</table>
      <value>
        <name>year</name>
        <rename>year</rename>
        <update>Y</update>
      </value>
      <value>
        <name>decade</name>
        <rename>decade</rename>
        <update>Y</update>
      </value>
    </lookup>
    <update_bypassed>N</update_bypassed>
    <attributes/>
    <GUI>
      <xloc>704</xloc>
      <yloc>304</yloc>
    </GUI>
  </transform>
  <transform>
    <name>One row per year</name>
    <type>CloneRow</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <addcloneflag>N</addcloneflag>
    <addclonenum>Y</addclonenum>
    <clonenumfield>offset</clonenumfield>
    <nrclonefield>nr_clones</nrclonefield>
    <nrcloneinfield>Y</nrcloneinfield>
