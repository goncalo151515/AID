    <sql>SELECT country_iso3, year, indicator_code, value
FROM stg_wdi
WHERE indicator_code IN ('NV.AGR.TOTL.ZS', 'NV.AGR.TOTL.CD', 'SL.AGR.EMPL.ZS',
